# ================================
# Application Configuration
# ================================
FLASK_ENV=production
FLASK_APP=src.web_server:app
SECRET_KEY=your-secret-key-here-change-in-production

# ================================
# Model Configuration
# ================================
MODEL_PATH=/app/models
INTENT_MODEL_NAME=klue/roberta-large
NER_MODEL_NAME=klue/roberta-large

# ================================
# Database Configuration
# ================================
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=beaver_ars
MYSQL_USER=beaver_user
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_ROOT_PASSWORD=your_root_password_here

# Database Pool
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# ================================
# Redis Cache Configuration
# ================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=your_redis_password_here
REDIS_MAX_CONNECTIONS=50
REDIS_TTL=3600

# ================================
# API Server Configuration
# ================================
API_HOST=0.0.0.0
API_PORT=5000
API_WORKERS=4
API_TIMEOUT=120
API_MAX_REQUESTS=1000
API_KEEP_ALIVE=5

# ================================
# Gunicorn Configuration
# ================================
GUNICORN_WORKERS=4
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=120
GUNICORN_LOG_LEVEL=info

# ================================
# Search Configuration
# ================================
BM25_WEIGHT=0.3
SEMANTIC_WEIGHT=0.7
SEARCH_TOP_K=10

# ================================
# Model Optimization
# ================================
ENABLE_QUANTIZATION=true
ENABLE_BATCH_INFERENCE=true
BATCH_SIZE=16
MAX_LENGTH=128

# ================================
# Logging Configuration
# ================================
LOG_LEVEL=INFO
LOG_FILE=/app/logs/beaver_ars.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# ================================
# Monitoring Configuration
# ================================
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_PASSWORD=admin

# ================================
# AWS Configuration (Optional)
# ================================
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
S3_BUCKET=beaver-ars-models

# ================================
# Docker Configuration
# ================================
DOCKER_IMAGE=beaver-ars
DOCKER_TAG=latest

# ================================
# Notification Configuration
# ================================
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
ALERT_EMAIL=admin@example.com

# ================================
# Security Configuration
# ================================
ALLOWED_HOSTS=localhost,127.0.0.1,beaver-ars.example.com
CORS_ORIGINS=https://beaver-ars.example.com
JWT_SECRET_KEY=your-jwt-secret-key-here

# ================================
# Performance Configuration
# ================================
WORKER_CONNECTIONS=1000
MAX_REQUESTS_JITTER=50
PREFETCH_MULTIPLIER=4
